# --- Servidor ---
PORT=4000
FLUXO_DB=server/data/fluxo.db
APP_URL=https://app.seudominio.com          # usado nos links de retorno do Stripe
FLUXO_ENCRYPTION_KEY=troque-por-um-segredo-longo   # criptografa token do banco (Plaid), SSN/EIN e a conta bancária dos funcionários (depósito direto). Guarde uma cópia FORA do servidor

# --- Plaid (conexão com bancos) ---  https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                            # sandbox | production
PLAID_WEBHOOK_URL=https://app.seudominio.com/api/plaid/webhook
# PLAID_DEMO=1                               # força o banco de demonstração (sem chaves ele já aparece fora de produção)

# --- Stripe (cobrança dos planos) ---  https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...              # do endpoint https://app.seudominio.com/api/stripe/webhook
# FLUXO_REQUIRE_PAYMENT=1                    # a conta só pode ser criada depois de pagar (landing page → Stripe → /welcome)
# FLUXO_ALLOW_MANUAL_PLAN=1                  # permite trocar o plano à mão mesmo com assinatura (só para testes)

# --- Hospedagem para vários clientes ---
# FLUXO_MULTI=1                               # um banco SQLite por empresa; cadastro público
# FLUXO_TRUST_PROXY=1                         # atrás de nginx/Caddy/Render: usa o IP real nos limites de tentativas
# FLUXO_ADMIN_EMAIL=voce@seudominio.com       # painel /admin (ver clientes, suspender). Senha com 12+ caracteres
# FLUXO_ADMIN_PASSWORD=
# FLUXO_BACKUP_DIR=/data/backups              # onde fica o backup diário (Configurações > Automações)

# --- E-mail (recuperação de senha) ---
# Escolha UM: SMTP (Gmail/Workspace com senha de app, Amazon SES, Mailgun...) ou Resend.
# APP_URL também é obrigatório: é o endereço que vai dentro do link do e-mail.
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0                               # 1 para a porta 465
# RESEND_API_KEY=
# MAIL_FROM="Fluxo <no-reply@seudominio.com>"
# FLUXO_MAIL_FILE=/tmp/emails.jsonl           # só para testar: grava os e-mails neste arquivo em vez de enviar

# URL pública da API do Harbor (ex.: https://harbor-api.seudominio.com). Se definida (junto com ADMIN_SUMMARY_KEY):
#  - cada novo teste grátis / cadastro vira um Lead no Harbor (origem "Trial signup", X-Capture-Key = ADMIN_SUMMARY_KEY);
#  - o vigia das tabelas de impostos cria uma TAREFA no Harbor (POST /api/public/product-alerts, X-Product-Key = ADMIN_SUMMARY_KEY)
#    quando o IRS/SSA publica tabelas novas ou o ano corrente está sem tabela (dedupe: fluxo-irs-tables-<ano>, fluxo-ssa-wagebase-<ano>,
#    fluxo-missing-table-<ano>). Sem as duas variáveis, isso é pulado em silêncio. Opcional.
# HARBOR_API_URL=

# Shared key Harbor sends in X-Admin-Key to read GET /api/admin-summary.
# ADMIN_SUMMARY_KEY=

# "Import from photo" (AI reads a photo/print and fills the contact; the person reviews before saving). Same ANTHROPIC_API_KEY as the rest.
# Monthly limit per company: Free 0 · Starter 0 · Essentials 100 · Plus 250 · Advanced 500 · Business 1500 · Enterprise 5000 (+100 migration pack in the first 30 days).
# Extra reads: US$ 0.10 each with a monthly cap the owner approves.
# PHOTO_IMPORT_MODEL=claude-sonnet-5-5
PHOTO_EXTRA_CENTS=10
PHOTO_EXTRA_CAPS_CENTS=1000,2500,5000,10000

# --- Folha "Plano B" (o Fluxo gera arquivos; nunca movimenta dinheiro nem envia nada ao governo) ---
# Vigia das tabelas de impostos (out–jan, 1x/dia): páginas observadas. Padrão:
# TAXWATCH_IRS_URL=https://www.irs.gov/pub/irs-pdf/p15t.pdf
# TAXWATCH_SSA_URL=https://www.ssa.gov/oact/cola/cbb.html
# E-mail do aviso de tabelas novas: OWNER_EMAILS e FLUXO_ADMIN_EMAIL (precisa de e-mail configurado acima).
# PDFs oficiais preenchíveis do IRS (f941-2026.pdf, f940-2026.pdf...). Só são usados quando o mapa de campos existir em
# server/src/payrollPdf.js (IRS_FIELD_MAPS); sem isso o Fluxo gera a planilha "transcribe to the official form". Ver README.
# FLUXO_IRS_FORMS_DIR=/data/irs-forms
