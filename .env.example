# --- Servidor ---
PORT=4000
FLUXO_DB=server/data/fluxo.db
APP_URL=https://app.seudominio.com          # usado nos links de retorno do Stripe
FLUXO_ENCRYPTION_KEY=troque-por-um-segredo-longo   # criptografa o token do banco (Plaid) no banco de dados

# --- Plaid (conexão com bancos) ---  https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                            # sandbox | production
PLAID_WEBHOOK_URL=https://app.seudominio.com/api/plaid/webhook
# PLAID_DEMO=1                               # força o banco de demonstração (sem chaves ele já aparece fora de produção)

# --- Stripe (cobrança dos planos) ---  https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...              # do endpoint https://app.seudominio.com/api/stripe/webhook
# FLUXO_REQUIRE_PAYMENT=1                    # a conta só pode ser criada depois de pagar (landing page → Stripe → /welcome)
# FLUXO_ALLOW_MANUAL_PLAN=1                  # permite trocar o plano à mão mesmo com assinatura (só para testes)
