{
  "name": "fluxo",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "i18n:build": "node tools/i18n-build.mjs",
    "i18n:check": "node tools/i18n-build.mjs && node tools/i18n-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
